# Required for real photo analysis
OPENAI_API_KEY=
# Set this to a vision-capable model available in your OpenAI account
OPENAI_MODEL=gpt-4.1-mini

# Optional: eBay Browse API (ACTIVE listings / asking prices)
# Create an eBay developer app and use its production Client ID + Client Secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Optional future sold-comps provider.
# eBay's Marketplace Insights sold-history API is restricted and not open to new users.
SOLD_COMPS_API_URL=
SOLD_COMPS_API_KEY=

PORT=3000
